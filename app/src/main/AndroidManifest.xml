<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <package android:name="org.lsposed.manager" />

        <package android:name="com.astraflow.tool" />
        <package android:name="com.astraflow.tool.debug" />

        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".app.MitianApp"
        android:allowBackup="true"
        android:description="@string/xposed_description"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mitian">

        <activity
            android:name=".ui.page.SettingsActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Mitian">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.INFO" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".ui.LauncherAlias"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".ui.page.HomeActivity"
            android:theme="@style/Theme.Mitian">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".ui.page.HomeActivity"
            android:exported="true"
            android:label="@string/app_name_launcher"
            android:theme="@style/Theme.Mitian" />

        <activity
            android:name=".ui.page.LyricDetailActivity"
            android:exported="false"
            android:label="@string/cap_lyric"
            android:parentActivityName=".ui.page.HomeActivity"
            android:theme="@style/Theme.Mitian.Detail" />
        <activity
            android:name=".ui.page.LinkDetailActivity"
            android:exported="false"
            android:label="@string/cap_link"
            android:parentActivityName=".ui.page.HomeActivity"
            android:theme="@style/Theme.Mitian.Detail" />

        <activity
            android:name=".ui.page.SponsorActivity"
            android:exported="false"
            android:label="@string/sponsor_title"
            android:parentActivityName=".ui.page.HomeActivity"
            android:theme="@style/Theme.Mitian.Detail" />

        <activity
            android:name=".ui.page.SheetActivity"
            android:exported="false"
            android:theme="@style/Theme.Mitian.Sheet"
            android:excludeFromRecents="true"
            android:noHistory="true" />

        <provider
            android:name=".app.LinkInboxProvider"
            android:authorities="com.astraflow.Chizuru.inbox"
            android:exported="true"
            android:grantUriPermissions="false" />

        <meta-data
            android:name="lyricon_module"
            android:value="true" />
        <meta-data
            android:name="lyricon_module_author"
            android:value="@string/lyricon_module_author" />
        <meta-data
            android:name="lyricon_module_description"
            android:value="@string/lyricon_module_description" />
        <meta-data
            android:name="lyricon_module_tags"
            android:resource="@array/lyricon_module_tags" />

        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="@string/xposed_description" />
        <meta-data
            android:name="xposedminversion"
            android:value="102" />

        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />
        <meta-data
            android:name="xposedsharedprefs"
            android:value="true" />

        <service
            android:name=".keepalive.KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="链接助手需要常驻，以便随时把剪贴板里的链接投给星河岛" />
        </service>

    </application>

</manifest>
